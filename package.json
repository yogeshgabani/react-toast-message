{
  "name": "react-toaster-message",
  "version": "1.4.0",
  "description": "Premium React toast notifications \u2014 Sonner-style stacking, Framer Motion animations, promise & upload-progress toasts, 14 variants, accessible, SSR-safe, TypeScript-first.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node init && tsup",
    "dev": "node init && tsup --watch",
    "demo": "vite examples",
    "demo:build": "vite build examples",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "toast",
    "react-toast",
    "toaster",
    "toast-notification",
    "react-notification",
    "notification",
    "notifications",
    "snackbar",
    "alert",
    "sonner",
    "sonner-alternative",
    "react-hot-toast-alternative",
    "react-toastify-alternative",
    "nextjs",
    "upload-progress",
    "progress",
    "framer-motion",
    "accessible",
    "animation",
    "swipe",
    "typescript"
  ],
  "author": "yogeshgabani",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yogeshgabani/react-toast-message.git"
  },
  "bugs": {
    "url": "https://github.com/yogeshgabani/react-toast-message/issues"
  },
  "homepage": "https://react-toast-message.netlify.app/",
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "dependencies": {
    "dotenv": "^8.2.0",
    "framer-motion": "^11.0.0",
    "node-fetch": "^3.3.2",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^29.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.11"
  }
}
